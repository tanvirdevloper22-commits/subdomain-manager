# Vercel token: vercel.com -> Settings -> Tokens (Full Account scope)
VERCEL_TOKEN=

# Your domain, e.g. abcde.com (its DNS must be on Vercel)
DOMAIN=abcde.com

# Password for signing in to this tool (use a long, random one)
ADMIN_PASSWORD=

# Optional: team id (team_xxx) if the domain belongs to a Vercel team
VERCEL_TEAM_ID=

# Optional: extra reserved names, comma separated (a default list is built in)
EXTRA_RESERVED=
