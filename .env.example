# Vercel token: vercel.com -> Settings -> Tokens (Full Account scope)
VERCEL_TOKEN=

# Aapka domain, jaise abcde.com (jiska DNS Vercel par hai)
DOMAIN=abcde.com

# Is tool me login ka password (lamba aur random rakho)
ADMIN_PASSWORD=

# Optional: agar domain Vercel team ke andar hai to team id (team_xxx)
VERCEL_TEAM_ID=

# Optional: extra reserved names, comma separated (default list code me hai)
EXTRA_RESERVED=
